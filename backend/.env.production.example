NODE_ENV=production
PORT=5000

# Must point to staging first, then production after verification.
DATABASE_URL="mysql://user:password@db-host:3306/database_name"

# Exact frontend origin. Do not use * with cookie auth.
FRONTEND_ORIGIN=https://www.example.com

JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=admin_session
COOKIE_SECURE=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ethio Origins Tours <contact@example.com>"
ADMIN_EMAIL=info@ethiooriginstour.com
EMAIL_ENABLED=true

# SendGrid (takes priority over SMTP when configured)
# Required in production — will fail to start if empty.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Local storage is only appropriate on a server with a persistent mounted disk.
# Vercel automatically falls back to PostgreSQL database media storage.
UPLOAD_ROOT=.
PUBLIC_FILE_BASE_URL=https://www.example.com
MAX_UPLOAD_MB=5

# Database storage needs no additional service credentials.
STORAGE_DRIVER=database
# Cloudinary remains optional for larger media libraries:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Alternatively configure STORAGE_CLOUDINARY_CLOUD_NAME,
# STORAGE_CLOUDINARY_API_KEY, and STORAGE_CLOUDINARY_API_SECRET separately.

# Redis (required for BullMQ email queue)
# Required in production — will fail to start if empty.
REDIS_URL=redis://localhost:6379

# Sentry (error tracking + performance monitoring)
# Required in production — will fail to start if empty.
SENTRY_DSN=

# AI Assistant (Chat)
ASSISTANT_PROVIDER=gemini         # gemini | openai | anthropic | grok
ASSISTANT_MODEL=gemini-2.5-flash  # Model for the chosen provider
# Only the API key for your chosen provider is required.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
