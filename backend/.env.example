NODE_ENV=development
PORT=5000

# Use a staging database or local imported dump, not production.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/database_name"

FRONTEND_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=admin_session
COOKIE_SECURE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ethio Origins Tours <contact@example.com>"
ADMIN_EMAIL=info@ethiooriginstour.com
EMAIL_ENABLED=false

# SendGrid (takes priority over SMTP when configured)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Path root for storing uploaded image files.
UPLOAD_ROOT=.
PUBLIC_FILE_BASE_URL=
MAX_UPLOAD_MB=5

# Persistent media storage. In hosted/serverless environments, configure
# Cloudinary (recommended) or S3; local disk is only suitable for development.
# STORAGE_DRIVER is optional and inferred when complete credentials are present.
# STORAGE_DRIVER=cloudinary
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Or use separate Cloudinary values instead of CLOUDINARY_URL:
STORAGE_CLOUDINARY_CLOUD_NAME=
STORAGE_CLOUDINARY_API_KEY=
STORAGE_CLOUDINARY_API_SECRET=

# Redis (required for BullMQ email queue)
REDIS_URL=redis://localhost:6379

# Sentry (error tracking + performance monitoring)
SENTRY_DSN=

# AI Assistant (Chat)
ASSISTANT_PROVIDER=gemini         # gemini | openai | anthropic | grok
ASSISTANT_MODEL=gemini-2.5-flash  # Model for the chosen provider
# Only the API key for your chosen provider is required.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Document Ingestion (RAG)
# Embedding model (defaults to text-embedding-004 for Gemini, text-embedding-3-small for OpenAI)
EMBEDDING_MODEL=text-embedding-004
# Directory where uploaded .docx files are stored (relative to backend/)
DOCUMENTS_DIR=./data
